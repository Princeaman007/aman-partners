# =============================================================
# Aman & Partners — variables d'environnement
#
# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais enregistrer .env.local dans Git.
#
# Les variables qui commencent par NEXT_PUBLIC_ sont visibles
# dans le navigateur : ne jamais y mettre de secret.
# =============================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de données PostgreSQL (Neon, région Europe) ---
# Chaîne de connexion avec pooling (l'adresse contient "-pooler").
DATABASE_URL=

# --- E-mails de notification : SMTP Infomaniak ---
# Tant que le site n'a pas son propre domaine, EMAIL_FROM doit utiliser
# la même adresse que SMTP_USER. Exemple : "Aman & Partners <contact@exemple.com>"
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Adresse qui reçoit les notifications de nouvelles demandes.
EMAIL_TO=

# --- Anti-spam Cloudflare Turnstile ---
# Clés de test officielles (toujours valides, développement uniquement) :
#   site   : 1x00000000000000000000AA
#   secret : 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Limitation des envois par visiteur ---
# Clé secrète servant à transformer les adresses IP en empreintes irréversibles.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=

# --- Stockage des pièces jointes : Cloudflare R2 (juridiction UE) ---
# Endpoint sans nom de compartiment : https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Dashboard d'administration (/admin) ---
# Adresse de connexion au dashboard.
ADMIN_EMAIL=
# Empreinte Argon2id du mot de passe, encodée en base64.
# Générer avec : node scripts/hash-admin-password.mjs
ADMIN_PASSWORD_HASH=
# Clé de signature des sessions (32 caractères minimum). La changer déconnecte tous les appareils.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Prise de rendez-vous : lien Cal.com ou Calendly ---
NEXT_PUBLIC_BOOKING_URL=

# --- Google : GA4 et conversions Google Ads (phase 6) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# --- Google Search Console : code de vérification du domaine (phase 7) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Meta : Pixel et Conversions API (phase 6) ---
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=