# =============================================================
# Aman & Partners — variables d'environnement
#
# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais enregistrer .env.local dans Git.
#
# Les variables qui commencent par NEXT_PUBLIC_ sont visibles
# dans le navigateur : ne jamais y mettre de secret.
# =============================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-mails de notification (phase 5) : Resend ou Brevo ---
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# --- Anti-spam Cloudflare Turnstile (phase 5) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Stockage des pièces jointes, compatible S3 : Cloudflare R2 ou AWS S3 (phase 5) ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Prise de rendez-vous : lien Cal.com ou Calendly ---
NEXT_PUBLIC_BOOKING_URL=

# --- Google : GA4 et conversions Google Ads (phase 6) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# --- Google Search Console : code de vérification du domaine (phase 7) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Meta : Pixel et Conversions API (phase 6) ---
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=